<% layout("/layouts/boilerplate") %>
<%= success %>

    <div id="filters">

    <div class="filters" data-category="Trending">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>

    <div class="filters" data-category="Rooms">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>

    <div class="filters" data-category="Iconic Cities">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Iconic Cities</p>
    </div>

    <div class="filters" data-category="Mountains">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </div>

    <div class="filters" data-category="Castles">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div>

    <div class="filters" data-category="Amazing Pools">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </div>

    <div class="filters" data-category="Camping">
        <div><i class="fa-solid fa-tents"></i></div>
        <p>Camping</p>
    </div>

    <div class="filters" data-category="Farms">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Farms</p>
    </div>

    <div class="filters" data-category="Arctic">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </div>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
        <button type="button" class="btn btn-outline-dark filter-button" id="filterButton">
            <i class="fa-solid fa-sliders"></i> Filters
        </button>
    </div>


    <div class="container">
    <div class="filter-panel" id="filterPanel">

        <div class="row">

            <div class="col-md-3 filter-group">
                <label for="maxPrice">Maximum Price</label>
                <input
                    type="number"
                    class="form-control"
                    id="maxPrice"
                    placeholder="e.g. 5000"
                    min="0"
                >
            </div>

            <div class="col-md-3 filter-group">
                <label for="guests">Guests</label>
                <input
                    type="number"
                    class="form-control"
                    id="guests"
                    placeholder="e.g. 4"
                    min="1"
                >
            </div>

            <div class="col-md-3 filter-group">
                <label for="propertyType">Property Type</label>
                <select class="form-select" id="propertyType">
                    <option value="">Any</option>
                    <option value="House">House</option>
                    <option value="Apartment">Apartment</option>
                    <option value="Villa">Villa</option>
                    <option value="Cabin">Cabin</option>
                    <option value="Hotel">Hotel</option>
                    <option value="Farm">Farm</option>
                    <option value="Cottage">Cottage</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="col-md-3 filter-group">
                <label for="bedrooms">Minimum Bedrooms</label>
                <input
                    type="number"
                    class="form-control"
                    id="bedrooms"
                    placeholder="e.g. 2"
                    min="1"
                >
            </div>

        </div>

        <button type="button" class="btn apply-filter-btn" id="applyFilters">
            Apply Filters
        </button>

        <button type="button" class="btn btn-outline-secondary" id="clearFilters">
            Clear
        </button>

    </div>
</div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings) { %>

    <div class="listing-card-container">

        <a href="/listings/<%= listing._id %>" class="listing-link">

            <div class="card col listing-card">
                <img 
                    src="<%= listing.image.url %>" 
                    class="card-img-top" 
                    alt="listing_image" 
                    style="height: 20rem"
                >

                <div class="card-img-overlay"></div>

                <div class="card-body">
                    <p class="card-text">
                        <%= listing.title %><br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %>/night
                        <i class="tax-info"> &nbsp; +18% GST</i>
                    </p>
                </div>
            </div>

        </a>

        <% if(currUser) { %>

            <button
                type="button"
                class="wishlist-btn <%= wishlistIds.includes(listing._id.toString()) ? 'active' : '' %>"
                data-listing-id="<%= listing._id %>"
            >
                <%= wishlistIds.includes(listing._id.toString()) ? '❤️' : '♡' %>
            </button>

        <% } %>

    </div>

<% } %>
    </div>
    

    <!-- <ul>
        <% for(let listing of allListings) { %>
            <li> <a href="/listings/<%= listing._id %>"><%= listing.title %></a></li>
        <% } %>
    </ul> -->



<script src="/js/script.js"></script>