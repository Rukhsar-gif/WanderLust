<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <h2 class="mb-4">My Trips 🧳</h2>

    <% if(bookings.length === 0) { %>

        <div class="text-center mt-5">
            <h4>No trips yet</h4>

            <p class="text-muted">
                Your booked stays will appear here.
            </p>

            <a href="/listings" class="btn btn-danger">
                Explore Listings
            </a>
        </div>

    <% } else { %>

        <div class="row">

            <% bookings.forEach(booking => { %>

                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm">

                        <% if (booking.listing) { %>
                            <img src="<%= booking.listing.image.url %>"
                            class="card-img-top"
                            style="height: 250px; object-fit: cover;"
                            alt="<%= booking.listing.title %>">
                        <% } %>

                        <div class="card-body">

                            <h4 class="card-title">
                                <%= booking.listing.title %>
                            </h4>

                            <p class="text-muted">
                                <%= booking.listing.location %>,
                                <%= booking.listing.country %>
                            </p>

                            <hr>

                            <p>
                                <strong>Check-in:</strong>
                                <%= booking.checkIn.toLocaleDateString("en-IN") %>
                            </p>

                            <p>
                                <strong>Check-out:</strong>
                                <%= booking.checkOut.toLocaleDateString("en-IN") %>
                            </p>

                            <p>
                                <strong>Guests:</strong>
                                <%= booking.guests %>
                            </p>

                            <p>
                                <strong>Total Price:</strong>
                                ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                            </p>

                            <a
                                href="/listings/<%= booking.listing._id %>"
                                class="btn btn-dark"
                            >
                                View Listing
                            </a>

                            <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger">Cancel Booking </button> </form>
                        </div>
                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>