<% layout("layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-md-8 offset-md-2">

        <h2 class="mb-4">Book Your Stay</h2>

        <div class="card p-4">

            <h4><%= listing.title %></h4>

            <p class="text-muted">
                <%= listing.location %>, <%= listing.country %>
            </p>

            <p>
                <strong>
                    ₹<%= listing.price.toLocaleString("en-IN") %>
                </strong>
                / night
            </p>

            <hr>

            <% if (bookings.length > 0) { %>

    <div class="alert alert-warning">
        <strong>Some dates are already booked.</strong>

        <ul class="mb-0 mt-2">
            <% bookings.forEach(booking => { %>
                <li>
                    <%= booking.checkIn.toLocaleDateString("en-IN") %>
                    -
                    <%= booking.checkOut.toLocaleDateString("en-IN") %>
                </li>
            <% }) %>
        </ul>
    </div>

<% } %>

            <form action="/bookings/<%= listing._id %>" method="POST">

                <div class="mb-3">
                    <label for="checkIn" class="form-label">
                        Check-in
                    </label>

                    <input
                        type="date"
                        id="checkIn"
                        name="checkIn"
                        class="form-control"
                        min="<%= new Date().toISOString().split('T')[0] %>"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="checkOut" class="form-label">
                        Check-out
                    </label>

                    <input
                        type="date"
                        id="checkOut"
                        name="checkOut"
                        class="form-control"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="guests" class="form-label">
                        Guests
                    </label>

                    <input
                        type="number"
                        id="guests"
                        name="guests"
                        class="form-control"
                        min="1"
                        max="<%= listing.guests %>"
                        value="1"
                        required
                    >

                    <small class="text-muted">
                        Maximum <%= listing.guests %> guests
                    </small>
                </div>

                <div id="priceSummary" class="mb-3" style="display:none;">
                    <hr>

                    <p>
                        <strong>Price per night:</strong>
                        ₹<span id="pricePerNight">
                            <%= listing.price.toLocaleString("en-IN") %>
                        </span>
                    </p>

                    <p>
                        <strong>Nights:</strong>
                        <span id="numberOfNights">0</span>
                    </p>

                    <h5>
                        Total:
                        ₹<span id="totalPrice">0</span>
                    </h5>
                </div>

                <button
                    type="submit"
                    class="btn btn-danger w-100"
                >
                    Confirm Booking
                </button>

            </form>

        </div>
    </div>
</div>

<script>
    const checkIn = document.getElementById("checkIn");
    const checkOut = document.getElementById("checkOut");

    const pricePerNight = <%= listing.price %>;

    const priceSummary = document.getElementById("priceSummary");
    const numberOfNights = document.getElementById("numberOfNights");
    const totalPrice = document.getElementById("totalPrice");

    const dateWarning = document.createElement("div");
    
    dateWarning.className = "alert alert-danger mt-2";
    dateWarning.style.display = "none";
    
    checkOut.parentElement.appendChild(dateWarning);


    function isDateBooked(date) {

    return bookedDates.some(booking => {

        const checkInDate = new Date(booking.checkIn);
        const checkOutDate = new Date(booking.checkOut);

        return date >= checkInDate && date < checkOutDate;
    });
}



    function calculatePrice() {

        if (!checkIn.value || !checkOut.value) {
            priceSummary.style.display = "none";
            return;
        }

        const startDate = new Date(checkIn.value);
        const endDate = new Date(checkOut.value);

        const difference = endDate - startDate;

        const conflict = bookedDates.some(booking => {

    const bookedStart = new Date(booking.checkIn);
    const bookedEnd = new Date(booking.checkOut);

    return (
        startDate < bookedEnd &&
        endDate > bookedStart
    );
});

if (conflict) {

    dateWarning.textContent =
        "These dates are already booked. Please select different dates.";

    dateWarning.style.display = "block";

    priceSummary.style.display = "none";

    return;

} else {

    dateWarning.style.display = "none";
}

        const nights = Math.ceil(
            difference / (1000 * 60 * 60 * 24)
        );

        if (nights <= 0) {
            priceSummary.style.display = "none";
            return;
        }

        const total = nights * pricePerNight;

        numberOfNights.textContent = nights;

        totalPrice.textContent =
            total.toLocaleString("en-IN");

        priceSummary.style.display = "block";
    }

    checkIn.addEventListener("change", calculatePrice);
    checkOut.addEventListener("change", calculatePrice);
</script>